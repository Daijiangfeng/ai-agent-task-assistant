# ============================================
# AI Agent Task Assistant - Environment Config
# ============================================

# -- 应用与安全 --
APP_NAME=AI Agent Task Assistant
APP_VERSION=0.1.0
DEBUG=false
# 运行环境：development | production
# production 下禁止一切静默降级（内存任务存储/MemorySaver/内存队列/内存短期记忆/Mock 工具），
# 启动时执行基础设施健康检查，核心依赖不可用直接终止启动（fail-fast）；
# 任务接收端点在未就绪时返回 503（GET /health/ready 可查询就绪详情）
ENVIRONMENT=development
# 基础设施健康检查：单组件探测超时（秒）/ 就绪状态缓存 TTL（秒，0=实时探测）
HEALTH_CHECK_TIMEOUT=2.0
HEALTH_CACHE_TTL=5.0
# API 认证（生产环境建议开启；开启后所有 /api/v1 需携带 API Key）
AUTH_ENABLED=false
# 逗号分隔的合法 API Key（请求通过 Authorization: Bearer <key> 或 X-API-Key: <key> 携带）
API_KEYS=

# -- 智谱 LLM 配置（Anthropic 兼容端点） --
# API Key 申请地址：https://open.bigmodel.cn
ANTHROPIC_AUTH_TOKEN=your_zhipu_api_key_here
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ZHIPU_MODEL=glm-4.5-air
ZHIPU_TEMPERATURE=0.7
ZHIPU_MAX_TOKENS=4096

# -- 智谱 OpenAI 兼容端点（Embedding 专用） --
ZHIPU_OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_EMBEDDING_MODEL=embedding-3

# -- PostgreSQL --
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
# 数据库连接超时（秒），用于后端探测与连接建立
DB_CONNECT_TIMEOUT=3

# -- 任务存储（TaskService 持久化后端） --
# auto: 优先 PostgreSQL（SQLAlchemy Async），不可用降级内存
# postgres/sqlite/memory: 强制指定后端
TASK_STORAGE_BACKEND=auto
# sqlite 后端任务库路径，留空则用 data/tasks.db
TASK_DB_PATH=

# -- LangGraph Checkpoint（任务执行状态持久化） --
# 启用后每个任务（thread_id=task_id）执行状态写入检查点，支持崩溃恢复/断点续跑
ENABLE_CHECKPOINTING=true
# auto: 优先 PostgreSQL（PostgresSaver），不可用降级内存 MemorySaver
# postgres/memory: 强制指定后端
CHECKPOINT_BACKEND=auto

# -- 任务队列（异步化：API 入队，Worker 消费） --
# auto: 优先 Redis（可靠持久队列），不可用降级进程内内存队列
# redis/memory: 强制指定后端
TASK_QUEUE_BACKEND=auto
# 是否在应用进程内启动内置 Worker；独立部署（python -m app.worker）时设 false
TASK_QUEUE_EMBEDDED_WORKER=true
REDIS_QUEUE_KEY=agent:tasks:queue
QUEUE_DEQUEUE_TIMEOUT=1.0

# -- Redis --
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# -- Web Search (Tavily) --
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
# 普通知识搜索结果的进程内缓存 TTL（秒；0=不缓存）
WEB_SEARCH_CACHE_TTL=21600
# 时效性搜索缓存 TTL（秒）；「今天/刚刚/当前」等强时效问题绕过缓存
WEB_SEARCH_TIME_SENSITIVE_CACHE_TTL=300
# 是否叠加 LLM 做搜索意图分类（默认关闭，使用确定性规则）
WEB_SEARCH_ENABLE_LLM_INTENT=false
# 来源质量分域（JSON 数组格式，支持子域匹配）：官方一手 / 可信 / 低质域名
WEB_SEARCH_OFFICIAL_DOMAINS=[]
WEB_SEARCH_TRUSTED_DOMAINS=[]
WEB_SEARCH_LOW_QUALITY_DOMAINS=[]

# -- Chroma 向量库（长期记忆后端存储） --
# 留空则使用默认目录 data/chroma
CHROMA_PERSIST_DIR=

# -- 向量库后端（可插拔，长期记忆使用） --
# chroma: 进程内持久化（开发/单机 Demo）
# pgvector: PostgreSQL 扩展（生产多实例部署；需安装 vector 扩展）
VECTOR_STORE_BACKEND=chroma
# pgvector 建表向量维度，必须与 embedding 模型输出一致（智谱 embedding-3 默认 2048）
EMBEDDING_DIM=2048

# -- SQLite 沙箱（SQL Query 工具） --
# 留空则使用默认路径 data/sandbox.db
SQLITE_SANDBOX_PATH=

# -- Memory 配置 --
ENABLE_LONG_TERM_MEMORY=false

# -- Agent 配置 --
MAX_REPLAN_ITERATIONS=3
MAX_EXECUTION_STEPS=10
# 单任务最大 Agent 执行轮数（多 Agent 协作上限），防止无限循环
MAX_AGENT_STEPS=10
# 单个子 Agent / Reviewer 的 LLM 调用超时（秒），防止外部模型挂起导致无限等待
SUB_AGENT_TIMEOUT_SECONDS=60.0

# -- 工具审批（HITL）策略 --
# 触发 HITL 的最低工具风险等级：L2（默认，仅高风险）/ L1（有业务影响）/ L0（全部工具）
TOOL_APPROVAL_LEVEL=L2
# 强制要求人工审批的工具名列表（JSON 数组格式，覆盖风险分级，优先级最高）
TOOL_APPROVAL_OVERRIDE_TOOLS=[]

# -- LLM 成本控制（单任务预算；0 表示不限制） --
MAX_LLM_CALLS_PER_TASK=20
MAX_TOTAL_TOKENS_PER_TASK=50000
BUDGET_LIMIT_USD=0
LLM_INPUT_COST_PER_1M=0
LLM_OUTPUT_COST_PER_1M=0