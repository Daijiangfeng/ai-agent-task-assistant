# ============================================
# AI Agent Task Assistant - Environment Config
# ============================================

# -- 智谱 LLM 配置（Anthropic 兼容端点） --
# API Key 申请地址：https://open.bigmodel.cn
ANTHROPIC_AUTH_TOKEN=your_zhipu_api_key_here
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ZHIPU_MODEL=glm-4.5-air
ZHIPU_TEMPERATURE=0.7
ZHIPU_MAX_TOKENS=4096

# -- 智谱 OpenAI 兼容端点（Embedding 专用） --
ZHIPU_OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_EMBEDDING_MODEL=embedding-3

# -- PostgreSQL --
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
# 数据库连接超时（秒），用于后端探测与连接建立
DB_CONNECT_TIMEOUT=3

# -- 任务存储（TaskService 持久化后端） --
# auto: 优先 PostgreSQL（SQLAlchemy Async），不可用降级内存
# postgres/sqlite/memory: 强制指定后端
TASK_STORAGE_BACKEND=auto
# sqlite 后端任务库路径，留空则用 data/tasks.db
TASK_DB_PATH=

# -- Redis --
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# -- Web Search (Tavily) --
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

# -- Chroma 向量库 --
# 留空则使用默认目录 data/chroma
CHROMA_PERSIST_DIR=

# -- 向量库后端（可插拔） --
# chroma: 进程内持久化（开发/单机 Demo）
# pgvector: PostgreSQL 扩展（生产多实例部署；需安装 vector 扩展）
VECTOR_STORE_BACKEND=chroma
# pgvector 建表向量维度，必须与 embedding 模型输出一致（智谱 embedding-3 默认 2048）
EMBEDDING_DIM=2048

# -- RAG 配置 --
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5

# -- RAG Rerank 精排（智谱 rerank 模型） --
ENABLE_RERANK=true
ZHIPU_RERANK_MODEL=rerank
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RERANK_SCORE_THRESHOLD=0.0

# -- SQLite 沙箱（SQL Query 工具） --
# 留空则使用默认路径 data/sandbox.db
SQLITE_SANDBOX_PATH=

# -- Memory 配置 --
ENABLE_LONG_TERM_MEMORY=false

# -- LangGraph Checkpoint（任务执行状态持久化） --
# 启用后每个任务（thread_id=task_id）执行状态写入检查点，支持崩溃恢复/断点续跑
ENABLE_CHECKPOINTING=true
# auto: 优先 PostgreSQL（PostgresSaver），不可用降级内存 MemorySaver
# postgres/memory: 强制指定后端
CHECKPOINT_BACKEND=auto

# -- Agent 配置 --
MAX_REPLAN_ITERATIONS=3
MAX_EXECUTION_STEPS=10

# -- 应用配置 --
APP_NAME=AI Agent Task Assistant
DEBUG=false